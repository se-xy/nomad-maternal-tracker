{
  "name": "NMT \u2013 Deliver",
  "nodes": [
    {
      "id": "every-minute",
      "name": "Every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        240
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "claim-messages",
      "name": "Claim messages",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        480,
        240
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM claim_notifications();",
        "options": {}
      }
    },
    {
      "id": "send-telegram",
      "name": "Send Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        720,
        240
      ],
      "parameters": {
        "chatId": "REPLACE_WITH_YOUR_CHAT_ID",
        "text": "={{ $json.message }}",
        "additionalFields": {
          "appendAttribution": false
        }
      }
    },
    {
      "id": "acknowledge-delivery",
      "name": "Acknowledge delivery",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        960,
        240
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT acknowledge_notification($1::bigint,$2);",
        "options": {
          "queryReplacement": "={{ [$('Claim messages').item.json.id, $('Claim messages').item.json.lease_token] }}"
        }
      }
    }
  ],
  "connections": {
    "Every minute": {
      "main": [
        [
          {
            "node": "Claim messages",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim messages": {
      "main": [
        [
          {
            "node": "Send Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Telegram": {
      "main": [
        [
          {
            "node": "Acknowledge delivery",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
